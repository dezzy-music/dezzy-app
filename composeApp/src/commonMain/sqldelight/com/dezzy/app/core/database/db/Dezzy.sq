-- Esquema propio de Dezzy (app KMP). Todas las marcas de tiempo son
-- milisegundos UTC reales (epoch). El importador de Dezzy 3.x (fase 11)
-- convierte su historial, que guardaba hora local como si fuera UTC.

import kotlin.Boolean;

CREATE TABLE track (
    video_id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    artists TEXT NOT NULL,
    album TEXT,
    thumbnail TEXT,
    duration_seconds INTEGER,
    spotify_id TEXT,
    updated_at INTEGER NOT NULL
);

CREATE TABLE favorite (
    video_id TEXT NOT NULL PRIMARY KEY REFERENCES track(video_id),
    liked_at INTEGER NOT NULL
);

CREATE INDEX favorite_liked_at ON favorite(liked_at);

-- Cada reproducción es una fila: las estadísticas, la racha y
-- «Tu año en música» necesitan todas, no sólo la última.
CREATE TABLE play_event (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    video_id TEXT NOT NULL REFERENCES track(video_id),
    played_at INTEGER NOT NULL
);

CREATE INDEX play_event_played_at ON play_event(played_at);
CREATE INDEX play_event_video ON play_event(video_id, played_at);

CREATE TABLE playlist (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    author TEXT,
    thumbnail TEXT,
    created_at INTEGER NOT NULL
);

CREATE TABLE playlist_entry (
    playlist_id TEXT NOT NULL REFERENCES playlist(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    video_id TEXT NOT NULL REFERENCES track(video_id),
    PRIMARY KEY (playlist_id, position)
);

-- Listas traídas de otro servicio (Spotify): qué lista remota corresponde a qué lista local.
CREATE TABLE imported_playlist (
    playlist_id TEXT NOT NULL PRIMARY KEY REFERENCES playlist(id) ON DELETE CASCADE,
    source TEXT NOT NULL,
    remote_id TEXT NOT NULL,
    synced_at INTEGER NOT NULL,
    UNIQUE(source, remote_id)
);

-- Caché del catálogo: el objeto entero en JSON (kotlinx.serialization).
CREATE TABLE catalog_cache (
    kind TEXT NOT NULL,
    id TEXT NOT NULL,
    payload TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (kind, id)
);

-- Caché persistente de URLs de audio (fase 3). Ligadas a la IP que las pidió.
CREATE TABLE stream_cache (
    video_id TEXT NOT NULL,
    quality TEXT NOT NULL,
    payload TEXT NOT NULL,
    expires_at INTEGER NOT NULL,
    PRIMARY KEY (video_id, quality)
);

-- Tiempo escuchado (fase 4): tramos de al menos 5 s, como mucho 3600 por fila.
-- Sin clave foránea a track: una fila huérfana no debe tumbar las estadísticas.
CREATE TABLE listen_event (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    video_id TEXT NOT NULL,
    started_at INTEGER NOT NULL,
    seconds INTEGER NOT NULL
);

CREATE INDEX listen_event_started_at ON listen_event(started_at);

-- Valores sueltos (p. ej. la cola guardada del reproductor, en JSON).
CREATE TABLE kv (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- track ----------------------------------------------------------------

-- Android 6.0 trae SQLite 3.8: sin «ON CONFLICT DO UPDATE». Se hace en dos
-- pasos dentro de una transacción (insertTrackIfAbsent + updateTrack).
insertTrackIfAbsent:
INSERT OR IGNORE INTO track(video_id, title, artists, album, thumbnail, duration_seconds, spotify_id, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateTrack:
UPDATE track SET
    title = :title,
    artists = :artists,
    album = coalesce(:album, album),
    thumbnail = coalesce(:thumbnail, thumbnail),
    duration_seconds = coalesce(:durationSeconds, duration_seconds),
    spotify_id = coalesce(:spotifyId, spotify_id),
    updated_at = :updatedAt
WHERE video_id = :videoId;

trackById:
SELECT * FROM track WHERE video_id = ?;

trackBySpotifyId:
SELECT * FROM track WHERE spotify_id = ? LIMIT 1;

-- favorite -------------------------------------------------------------

favorites:
SELECT track.* FROM favorite JOIN track USING (video_id)
ORDER BY favorite.liked_at DESC;

isFavorite:
SELECT count(*) FROM favorite WHERE video_id = ?;

addFavorite:
INSERT OR IGNORE INTO favorite(video_id, liked_at) VALUES (?, ?);

removeFavorite:
DELETE FROM favorite WHERE video_id = ?;

-- historial ------------------------------------------------------------

addPlay:
INSERT INTO play_event(video_id, played_at) VALUES (?, ?);

-- Recientes sin repetir: la última vez que sonó cada canción.
recentTracks:
SELECT track.* FROM track
JOIN (
    SELECT video_id, max(played_at) AS last_played
    FROM play_event GROUP BY video_id
) AS last USING (video_id)
ORDER BY last.last_played DESC
LIMIT ?;

playsBetween:
SELECT * FROM play_event WHERE played_at >= ? AND played_at < ? ORDER BY played_at;

clearPlays:
DELETE FROM play_event;

-- Las que más sonaron desde una fecha (marcación rápida del Inicio).
mostPlayed:
SELECT track.* FROM track
JOIN (
    SELECT video_id, count(*) AS plays, max(played_at) AS last_played
    FROM play_event WHERE played_at >= ? GROUP BY video_id
) AS top USING (video_id)
ORDER BY top.plays DESC, top.last_played DESC
LIMIT ?;

-- Favoritos que no suenan desde una fecha («favoritos olvidados»).
forgottenFavorites:
SELECT track.* FROM favorite JOIN track USING (video_id)
WHERE track.video_id NOT IN (SELECT video_id FROM play_event WHERE played_at >= ?)
ORDER BY favorite.liked_at DESC
LIMIT ?;

-- playlists ------------------------------------------------------------

insertPlaylist:
INSERT INTO playlist(id, title, author, thumbnail, created_at) VALUES (?, ?, ?, ?, ?);

playlists:
SELECT playlist.*, (SELECT count(*) FROM playlist_entry WHERE playlist_id = playlist.id) AS track_count
FROM playlist ORDER BY created_at DESC;

playlistById:
SELECT * FROM playlist WHERE id = ?;

playlistTracks:
SELECT track.* FROM playlist_entry JOIN track USING (video_id)
WHERE playlist_entry.playlist_id = ?
ORDER BY playlist_entry.position;

nextPosition:
SELECT coalesce(max(position) + 1, 0) FROM playlist_entry WHERE playlist_id = ?;

addEntry:
INSERT INTO playlist_entry(playlist_id, position, video_id) VALUES (?, ?, ?);

removeEntriesForVideo:
DELETE FROM playlist_entry WHERE playlist_id = ? AND video_id = ?;

deletePlaylistEntries:
DELETE FROM playlist_entry WHERE playlist_id = ?;

deletePlaylist:
DELETE FROM playlist WHERE id = ?;

clearEntries:
DELETE FROM playlist_entry WHERE playlist_id = ?;

updatePlaylistMeta:
UPDATE playlist SET title = :title, thumbnail = :thumbnail WHERE id = :id;

-- listas importadas ----------------------------------------------------

-- Sólo cuenta si la lista local sigue existiendo (por si se borró sin cascada).
importedPlaylistId:
SELECT imported_playlist.playlist_id FROM imported_playlist
JOIN playlist ON playlist.id = imported_playlist.playlist_id
WHERE imported_playlist.source = ? AND imported_playlist.remote_id = ?;

-- REPLACE: si quedaba una fila huérfana con el mismo (source, remote_id), la sustituye.
insertImported:
INSERT OR REPLACE INTO imported_playlist(playlist_id, source, remote_id, synced_at) VALUES (?, ?, ?, ?);

touchImported:
UPDATE imported_playlist SET synced_at = :syncedAt WHERE playlist_id = :playlistId;

importedRemoteIds:
SELECT imported_playlist.remote_id FROM imported_playlist
JOIN playlist ON playlist.id = imported_playlist.playlist_id
WHERE imported_playlist.source = ?;

-- caché de catálogo ----------------------------------------------------

putCatalog:
INSERT OR REPLACE INTO catalog_cache(kind, id, payload, updated_at) VALUES (?, ?, ?, ?);

getCatalog:
SELECT payload FROM catalog_cache WHERE kind = ? AND id = ?;

-- caché de streams -----------------------------------------------------

putStream:
INSERT OR REPLACE INTO stream_cache(video_id, quality, payload, expires_at) VALUES (?, ?, ?, ?);

getStream:
SELECT payload, expires_at FROM stream_cache WHERE video_id = ? AND quality = ?;

deleteStream:
DELETE FROM stream_cache WHERE video_id = ?;

purgeExpiredStreams:
DELETE FROM stream_cache WHERE expires_at < ?;

clearStreams:
DELETE FROM stream_cache;

-- tiempo escuchado -----------------------------------------------------

addListen:
INSERT INTO listen_event(video_id, started_at, seconds) VALUES (?, ?, ?);

listenSecondsBetween:
SELECT coalesce(sum(seconds), 0) FROM listen_event WHERE started_at >= ? AND started_at < ?;

-- Días (en hora local, desplazada por el primer parámetro) con algo escuchado, del más reciente al más viejo.
listenDays:
SELECT DISTINCT (started_at + :offset) / 86400000 AS day FROM listen_event
WHERE started_at >= :since ORDER BY day DESC;

listenSecondsForVideo:
SELECT coalesce(sum(seconds), 0) FROM listen_event WHERE video_id = ? AND started_at >= ?;

-- kv -------------------------------------------------------------------

putKv:
INSERT OR REPLACE INTO kv(key, value) VALUES (?, ?);

getKv:
SELECT value FROM kv WHERE key = ?;

deleteKv:
DELETE FROM kv WHERE key = ?;

-- red social P2P (fase 9a) ----------------------------------------------
-- Copia local de la red social (Nostr). Se reconstruye desde los relés si se borra.
-- Las fechas de estas tablas son segundos (como en los eventos de Nostr), no milisegundos.
-- Van con IF NOT EXISTS porque P2PStore también las crea al arrancar en bases ya existentes.

CREATE TABLE IF NOT EXISTS p2p_message (
    id TEXT NOT NULL PRIMARY KEY,
    peer TEXT NOT NULL,
    from_me INTEGER AS Boolean NOT NULL,
    content TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    song_json TEXT,
    juntos_link TEXT
);

CREATE INDEX IF NOT EXISTS p2p_message_peer ON p2p_message(peer);
CREATE INDEX IF NOT EXISTS p2p_message_created ON p2p_message(created_at);

CREATE TABLE IF NOT EXISTS p2p_profile (
    pubkey TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    about TEXT NOT NULL,
    picture TEXT,
    is_private INTEGER AS Boolean NOT NULL,
    updated_at INTEGER NOT NULL,
    banner TEXT,
    banner_video TEXT
);

CREATE TABLE IF NOT EXISTS p2p_private_post (
    id TEXT NOT NULL PRIMARY KEY,
    author TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    json TEXT NOT NULL
);

CREATE INDEX IF NOT EXISTS p2p_private_post_author ON p2p_private_post(author);

CREATE TABLE IF NOT EXISTS p2p_private_reaction (
    id TEXT NOT NULL PRIMARY KEY,
    post_id TEXT NOT NULL,
    author TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    type TEXT NOT NULL,
    content TEXT NOT NULL,
    reply_to TEXT
);

CREATE INDEX IF NOT EXISTS p2p_private_reaction_post ON p2p_private_reaction(post_id);

CREATE TABLE IF NOT EXISTS p2p_follow_request (
    pubkey TEXT NOT NULL,
    incoming INTEGER AS Boolean NOT NULL,
    status TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    PRIMARY KEY (pubkey, incoming)
);

CREATE TABLE IF NOT EXISTS p2p_chat_state (
    peer TEXT NOT NULL PRIMARY KEY,
    last_read_at INTEGER NOT NULL
);

p2pMessageExists:
SELECT count(*) FROM p2p_message WHERE id = ?;

p2pInsertMessage:
INSERT OR IGNORE INTO p2p_message(id, peer, from_me, content, created_at, song_json, juntos_link)
VALUES (?, ?, ?, ?, ?, ?, ?);

p2pMessages:
SELECT id, peer, from_me, content, created_at, song_json, juntos_link
FROM p2p_message WHERE peer = ? ORDER BY created_at ASC;

p2pLastMessages:
SELECT m.id, m.peer, m.from_me, m.content, m.created_at, m.song_json, m.juntos_link
FROM p2p_message m
JOIN (SELECT peer, MAX(created_at) AS last_at FROM p2p_message GROUP BY peer) l
    ON m.peer = l.peer AND m.created_at = l.last_at
GROUP BY m.peer ORDER BY m.created_at DESC;

p2pUnreadCounts:
SELECT m.peer, COUNT(*) AS unread FROM p2p_message m
LEFT JOIN p2p_chat_state s ON s.peer = m.peer
WHERE m.from_me = 0 AND m.created_at > IFNULL(s.last_read_at, 0)
GROUP BY m.peer;

p2pUpsertChatState:
INSERT OR REPLACE INTO p2p_chat_state(peer, last_read_at) VALUES (?, ?);

p2pDeleteConversation:
DELETE FROM p2p_message WHERE peer = ?;

p2pUpsertProfile:
INSERT OR REPLACE INTO p2p_profile(pubkey, name, about, picture, is_private, updated_at, banner, banner_video)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

p2pProfiles:
SELECT pubkey, name, about, picture, is_private, updated_at, banner, banner_video
FROM p2p_profile WHERE pubkey IN :pubkeys;

p2pInsertPrivatePost:
INSERT OR IGNORE INTO p2p_private_post(id, author, created_at, json) VALUES (?, ?, ?, ?);

p2pPrivatePosts:
SELECT id, author, created_at, json FROM p2p_private_post
WHERE author IN :authors ORDER BY created_at DESC LIMIT :limit;

p2pPrivatePostsOf:
SELECT id, author, created_at, json FROM p2p_private_post
WHERE author = ? ORDER BY created_at DESC LIMIT ?;

p2pPrivatePost:
SELECT id, author, created_at, json FROM p2p_private_post WHERE id = ?;

p2pDeletePrivatePost:
DELETE FROM p2p_private_post WHERE id = ?;

p2pInsertPrivateReaction:
INSERT OR IGNORE INTO p2p_private_reaction(id, post_id, author, created_at, type, content, reply_to)
VALUES (?, ?, ?, ?, ?, ?, ?);

p2pPrivateReactions:
SELECT id, post_id, author, created_at, type, content, reply_to
FROM p2p_private_reaction WHERE post_id IN :postIds;

p2pUpsertFollowRequest:
INSERT OR REPLACE INTO p2p_follow_request(pubkey, incoming, status, created_at) VALUES (?, ?, ?, ?);

p2pPendingIncomingRequests:
SELECT pubkey, incoming, status, created_at FROM p2p_follow_request
WHERE incoming = 1 AND status = 'pending' ORDER BY created_at DESC;

p2pApprovedFollowers:
SELECT pubkey FROM p2p_follow_request WHERE incoming = 1 AND status = 'approved';

p2pFollowRequest:
SELECT pubkey, incoming, status, created_at FROM p2p_follow_request WHERE pubkey = ? AND incoming = ?;

p2pClearMessages:
DELETE FROM p2p_message;

p2pClearPrivatePosts:
DELETE FROM p2p_private_post;

p2pClearPrivateReactions:
DELETE FROM p2p_private_reaction;

p2pClearFollowRequests:
DELETE FROM p2p_follow_request;

p2pClearChatState:
DELETE FROM p2p_chat_state;
